# Face API settings (Vercel project env vars in production). Never commit real values.

# Databricks (face templates, accounts, interactions). All three switch the store to Databricks.
DATABRICKS_HOST=dbc-38b8f0fd-7cd5.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=9a5194b5eb7321ed

# Auth0: access tokens from the website (API identifier = the website's NEXT_PUBLIC_AUTH0_AUDIENCE).
AUTH0_DOMAIN=cashcoin.ca.auth0.com
AUTH0_AUDIENCE=https://api.cashcan.biz

# Bins: comma-separated "bin_id:key" pairs; the bin sends its key as X-Bin-Key. Add each bin to workspace.cashcan_app.bins too.
BIN_API_KEYS=
# POST /interactions works without a bin key (demo). Set to 1 to require one. /gallery and bins naming users directly always need a key.
BIN_AUTH_REQUIRED=0

# Signs bin session tokens so any server instance can check them (app/sessions.py). A long random string, e.g.
# `openssl rand -hex 32`. Without it a session only works on the instance that issued it. Changing it ends open sessions.
SESSION_SECRET=

# Payouts: the website's Node route that signs the devnet transfer, and the secret shared with it (same value as the website's).
PAYOUT_URL=https://cashcan.biz/api/payout
PAYOUT_SECRET=
# Optional tuning (defaults shown)
# MIN_CONFIDENCE=0.75            # classifier confidence needed for a reward
# PAYOUT_COOLDOWN_SECONDS=30     # one paying drop per user per window
# PAYOUT_TIMEOUT_SECONDS=8       # how long POST /interactions waits for the payout route
# PAYOUT_MAX_ATTEMPTS=5          # sends tried for a failed payout before it stays failed
# PAYOUT_RETRY_BASE_SECONDS=30   # retry backoff: 30 s, 60 s, 120 s, ...
# PAYOUT_STUCK_SECONDS=180       # a payout still "sending" after this is resolved by memo lookup

# Vercel cron (vercel.json) sends "Authorization: Bearer $CRON_SECRET" to /face-api/cron/reconcile. Set the same value as
# CRON_SECRET in the Vercel project; Vercel adds the header itself.
CRON_SECRET=
