# Auth0 Application (Application Type: SPA) settings. Both must be NEXT_PUBLIC_
# since the SDK runs client-side. Not secrets — safe to expose to the browser.
NEXT_PUBLIC_AUTH0_DOMAIN=cashcoin.ca.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=1fmf9OX10wXLFWEAh7v5ZwZ9m2q3ltW4

# Auth0 API identifier of the face API (must match face_api's AUTH0_AUDIENCE). Needed for /enroll to
# send a signed-in access token. Leave empty only when the face API runs without Auth0 (local dev).
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.cashcan.biz
# Where the browser calls the face API. Defaults to /face-api (routed by Vercel in production).
# NEXT_PUBLIC_FACE_API_URL=/face-api
# Local dev only: proxy /face-api/* to this origin (e.g. a face API started with uvicorn on :8000).
# FACE_API_ORIGIN=http://localhost:8000

# Face match is mandatory after sign-up: /dashboard and /account send users without one to /enroll.
# Set to 0 only for local development without a face service.
# NEXT_PUBLIC_REQUIRE_FACE=0

# ---- Server-only (never NEXT_PUBLIC_): devnet reward payouts, app/api/payout ----
# Treasury key in base58 (`cd backend && npm run init-treasury && npm run cli -- export-secret`). Devnet only. Never commit it.
TREASURY_SECRET_KEY=
# Devnet RPC (a mainnet URL is refused). The public endpoint works; a dedicated devnet RPC is more reliable.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Shared with the face API (same value as face_api's PAYOUT_SECRET): only the face API may call /api/payout.
PAYOUT_SECRET=
# Vercel env vars are project-wide: this is the same variable the face API's /cron/reconcile checks (the website itself
# does not read it). Vercel's cron sends it as "Authorization: Bearer ...".
CRON_SECRET=
