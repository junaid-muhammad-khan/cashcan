{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": "website",
      "framework": "nextjs"
    },
    "face_api": {
      "root": "face_api",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/face-api/(.*)",
      "destination": {
        "service": "face_api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "website"
      }
    }
  ],
  "crons": [
    {
      "path": "/face-api/cron/reconcile",
      "schedule": "17 10 * * *"
    }
  ]
}
