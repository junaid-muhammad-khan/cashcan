# Copy to .env. Leave AUTH0_* empty to use the dev login (DEBUG only).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
FRONTEND_URL=http://localhost:5173

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Allowed Callback URL in Auth0: http://localhost:5173/auth/callback
# Allowed Logout URL in Auth0:   http://localhost:5173

# Reward config (lamports). 1 SOL = 1_000_000_000 lamports.
CONTAMINATED_REWARD_FRACTION=0.5
