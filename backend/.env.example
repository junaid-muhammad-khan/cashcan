# Solana cluster this backend talks to: devnet, testnet, mainnet-beta, or
# localnet (a local `solana-test-validator` — unlimited instant airdrops, no
# dependency on the public faucet; recommended for live demos).
SOLANA_CLUSTER=devnet

# Optional: base58-encoded secret key for the treasury wallet. If unset, the CLI
# generates one on first `init-treasury` run and stores it in treasury-keypair.json
# (gitignored). Never put a mainnet key here.
# TREASURY_SECRET_KEY=

# Minimum classifier confidence required before any payout is issued.
MIN_CONFIDENCE=0.75

# Seconds a user must wait between payouts (anti-abuse rate limit).
PAYOUT_COOLDOWN_SECONDS=30

# Databricks activity log (workspace.cashcan.activity_log on the Serverless
# Starter Warehouse). Generate the token at Settings -> Developer -> Access
# tokens in the workspace; never commit a real value here.
DATABRICKS_SERVER_HOSTNAME=dbc-38b8f0fd-7cd5.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/9a5194b5eb7321ed
DATABRICKS_TOKEN=
