# Operator CLI for the devnet treasury (payouts themselves run in website/app/api/payout).
# Devnet RPC. A mainnet URL is refused.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: the treasury key in base58. If unset, `npm run init-treasury` creates treasury-keypair.json (gitignored).
# Never commit a real value, never use a mainnet key.
# TREASURY_SECRET_KEY=

# For `npm run cli -- test-payout`: the website's payout route and its shared secret.
# PAYOUT_URL=https://cashcan.biz/api/payout
# PAYOUT_SECRET=
