{
  "datasets": [
    {
      "name": "ds_city",
      "displayName": "City activity",
      "queryLines": [
        "SELECT interaction_id, ts, bin_id, bin_name, bin_location, item_class, confidence,\n",
        "  recognised, recognition, sorter, reward_cents, lamports_paid, sol_paid, cad_paid,\n",
        "  payout_status, reason, tx_signature,\n",
        "  CAST(recognised AS INT) AS is_recognised,\n",
        "  CASE payout_status WHEN 'paid' THEN 'Paid' WHEN 'held' THEN 'Held (no wallet)'\n",
        "       WHEN 'failed' THEN 'Failed (retrying)' WHEN 'pending' THEN 'Paying' WHEN 'sending' THEN 'Paying'\n",
        "       ELSE 'No reward' END AS payout_label\n",
        "FROM city_activity\n"
      ],
      "columns": [
        {
          "displayName": "Items Sorted",
          "description": "Count of drops",
          "expression": "COUNT(`interaction_id`)"
        },
        {
          "displayName": "Recognised Share",
          "description": "Share of drops by a recognised (enrolled) person",
          "expression": "AVG(`is_recognised`)"
        },
        {
          "displayName": "SOL Paid",
          "description": "Devnet SOL paid out",
          "expression": "SUM(`sol_paid`)"
        },
        {
          "displayName": "CAD Paid",
          "description": "CAD value of payouts, at the rate used when each was sent",
          "expression": "SUM(`cad_paid`)"
        },
        {
          "displayName": "Rewards Earned",
          "description": "Reward owed in CAD cents (paid, held or on the way)",
          "expression": "SUM(`reward_cents`)"
        },
        {
          "displayName": "Sorters",
          "description": "Distinct recognised people",
          "expression": "COUNT(DISTINCT `sorter`)"
        }
      ]
    }
  ],
